							"510 NOT_EXTENDED",
							"511 NETWORK_AUTHENTICATION_REQUIRED"
						]
					},
					"errors": { "type": "array", "items": { "type": "string" } },
					"message": { "type": "string" },
					"data": { "type": "string" },
					"timestamp": { "type": "string", "format": "date-time" }
				}
			},
			"MeResponse": {
				"type": "object",
				"properties": {
					"id": { "type": "string" },
