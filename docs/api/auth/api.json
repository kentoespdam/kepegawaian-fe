{
	"openapi": "3.1.0",
	"info": {
		"title": "Kepegawaian Rest API",
		"description": "Need JWT Token for execute this API",
		"contact": { "name": "Kent-Os", "email": "kentoes.pdam@gmail.com" },
		"license": { "name": "License of API", "url": "API license URL" },
		"version": "1.0.0"
	},
	"servers": [{ "url": "http://192.168.1.211:8080", "description": "Generated server url" }],
	"security": [{ "BearerAuthentication": [] }],
	"paths": {
		"/auth/session": {
			"get": {
				"tags": ["auth-controller"],
				"operationId": "index",
				"parameters": [{ "name": "X-Appwrite-JWT", "in": "header", "required": true, "schema": { "type": "string" } }],
				"responses": { "200": { "description": "OK", "content": { "*/*": { "schema": { "type": "string" } } } } }
			}
		},
		"/auth/csrf-token": {
			"get": {
				"tags": ["auth-controller"],
				"operationId": "csrfToken",
				"responses": {
					"200": {
						"description": "OK",
						"content": { "*/*": { "schema": { "$ref": "#/components/schemas/SingleResultString" } } }
					}
				}
			}
		},
		"/account/me": {
			"get": {
				"tags": ["account-controller"],
				"operationId": "me",
				"responses": {
					"200": {
						"description": "OK",
						"content": { "*/*": { "schema": { "$ref": "#/components/schemas/SingleResultMeResponse" } } }
					}
				}
			}
		}
	},
	"components": {
		"schemas": {
			"SingleResultString": {
				"type": "object",
