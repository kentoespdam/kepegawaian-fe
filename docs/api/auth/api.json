						"type": "string",
						"enum": [
							"100 CONTINUE",
							"101 SWITCHING_PROTOCOLS",
							"102 PROCESSING",
							"103 EARLY_HINTS",
							"200 OK",
							"201 CREATED",
							"202 ACCEPTED",
							"203 NON_AUTHORITATIVE_INFORMATION",
							"204 NO_CONTENT",
							"205 RESET_CONTENT",
							"206 PARTIAL_CONTENT",
							"207 MULTI_STATUS",
							"208 ALREADY_REPORTED",
							"226 IM_USED",
							"300 MULTIPLE_CHOICES",
							"301 MOVED_PERMANENTLY",
							"302 FOUND",
							"303 SEE_OTHER",
							"304 NOT_MODIFIED",
							"307 TEMPORARY_REDIRECT",
							"308 PERMANENT_REDIRECT",
